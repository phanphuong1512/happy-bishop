{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "happy-bishop",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "happybishops.com",
      "custom_domain": true
    },
    {
      "pattern": "www.happybishops.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "happy-bishop"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "happy-bishop",
      "database_id": "8bcdea0e-ab68-47dd-9f44-e0508eb8fcc6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "happy-bishop"
    }
  ]
}
